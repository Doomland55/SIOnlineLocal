{
  "name": "sionline",
  "version": "1.0.0",
  "description": "SIGame web client",
  "main": "index.html",
  "scripts": {
    "build-dev": "webpack --mode development",
    "build-prod": "webpack --mode production",
    "build-steam-dev": "webpack --mode development --env isSteam=true",
    "build-steam": "webpack --mode production --env isSteam=true",
    "build-lib-table": "webpack --mode production --env type=library-table",
    "build-lib-player": "webpack --mode production --env type=library-player",
    "build-lib-quest": "webpack --mode production --env type=library-quest",
    "start": "webpack serve --mode development",
    "server": "ts-node --transpile-only --project server/tsconfig.json server/src/index.ts",
    "test:server": "node server/scripts/seats-test.js && node server/scripts/smoke-test.js && node server/scripts/signalr-client-test.js && node server/scripts/answer-options-test.js && node server/scripts/host-rights-test.js && node server/scripts/midgame-rules-test.js",
    "test:local-server": "jest test/localServer.test.ts",
    "make-test-package": "node server/scripts/make-test-package.js",
    "serve-local": "npm run build-local && npm run server",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test-scenario": "ts-node ./src/Runner.ts",
    "lint": "eslint . --ext .ts --ext .tsx",
    "build-local": "webpack --mode development --env local=true"
  },
  "keywords": [
    "sigame"
  ],
  "author": "Vladimir Khil",
  "license": "MIT",
  "repository": "https://github.com/VladimirKhil/SIOnline",
  "dependencies": {
    "@microsoft/signalr": "10.0.0",
    "@microsoft/signalr-protocol-msgpack": "10.0.0",
    "@msgpack/msgpack": "^3.1.3",
    "@reduxjs/toolkit": "^2.2.1",
    "accountservice-client": "1.3.0",
    "appregistry-client": "1.0.0",
    "emoji-picker-react": "4.19.1",
    "express": "^5.3.0",
    "firebase": "12.13.0",
    "jszip": "^3.10.1",
    "localized-strings": "2.0.3",
    "mime-types": "^3.0.2",
    "nosleep.js": "^0.12.0",
    "openai": "6.37.0",
    "qrcode.react": "^4.0.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-redux": "8.1.3",
    "redux": "5.0.1",
    "redux-thunk": "3.1.0",
    "sax": "^1.6.1",
    "sicontent-client": "1.0.15",
    "sistatistics-client": "1.5.1",
    "sistorage-client": "1.4.0",
    "ws": "^8.22.2"
  },
  "overrides": {
    "@microsoft/signalr": {
      "eventsource": "^2.0.2"
    },
    "serialize-javascript": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@svgr/webpack": "^7.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^27.5.2",
    "@types/mime-types": "^3.0.1",
    "@types/react": "^17.0.38",
    "@types/react-dom": "^17.0.11",
    "@types/react-redux": "^7.1.21",
    "@types/sax": "^1.2.7",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^5.8.0",
    "@typescript-eslint/parser": "^5.8.0",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^6.5.1",
    "cssnano": "^6.0.0",
    "eslint": "^8.16.0",
    "eslint-config-airbnb-typescript": "^16.1.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "file-loader": "^6.2.0",
    "html-loader": "^3.0.1",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^28.1.0",
    "jest-environment-jsdom": "^30.5.2",
    "msw": "^2.12.7",
    "postcss-import": "^14.0.2",
    "postcss-loader": "^7.2.4",
    "postcss-preset-env": "^7.1.0",
    "sass": "^1.77.8",
    "sass-loader": "^16.0.0",
    "style-loader": "^3.3.1",
    "ts-jest": "^28.0.3",
    "ts-loader": "^9.3.0",
    "ts-node": "^10.4.0",
    "typescript": "^6.0.3",
    "url-loader": "^4.1.1",
    "val-loader": "^5.0.1",
    "webpack": "^5.94.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^6.0.0",
    "workbox-webpack-plugin": "^7.3.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.test.json"
      }
    },
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "<rootDir>/test/styleMock.js",
      "\\.(svg|png|jpe?g|gif|webp|mp3|wav|ogg|ttf|eot|woff2?)$": "<rootDir>/test/fileMock.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "/dist/"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
